Items: {
	FlameManaWard: {
		DisplayName: 화염 마나 결계
		Tooltip:
			'''
			마나 화상을 포함한 화상 지속 피해를 마나 소모로 대신 지불합니다.
			초당 최대 20의 체력 피해를 치환하며, 피해 1당 마나 10을 소모합니다.
			역병보석과 광채의 지속 피해 상쇄 효과를 먼저 합산하여 적용합니다.
			마나가 부족하면 치환하지 못한 피해는 체력으로 받습니다.
			'''
	}

	PhantomDragonLauncher: {
		DisplayName: 팬텀 드래곤 발사기
		Tooltip:
			'''
			영혼을 대가로 팬텀 드래곤과 계약하여 함께 싸웁니다.
			[DRAGON_KEY] 키를 눌러 팬텀 드래곤의 공격 모드와 방어 모드를 전환할 수 있습니다.
			공격 모드에서는 피해를 입히거나 입을 수 있으며, 방어 모드에서는 피해를 입히거나 입지 않습니다.
			드래곤이 누적 피해 10,000을 달성할 때마다 플레이어에게 날아가는 회복 구체를 생성합니다.
			드래곤은 당신의 여정이 진행될수록 더욱 강력해지며, 드래곤이 사망하면 [c/FF4040:플레이어 또한 사망합니다].
			현재 드래곤의 스탯
			체력 : [DRAGON_HP]
			공격력 : [DRAGON_DAMAGE]
			'''
	}

	HiveLauncher: {
		DisplayName: 벌집 발사기
		Tooltip:
			'''
			5초마다 벌통 1개 충전, 최대 5개 저장
			마법 공격 적중 시 벌통 NPC를 연속 발사
			벌통이 충돌하거나 요격되면 소형 벌 NPC 10마리 방출
			소형 벌은 각각 25의 기본 피해를 주며 적 투사체에 요격당할 수 있음
			지속 적중 기준 기본 DPS 50 (방어력, 요격 및 빗나감 미포함)
			'''
	}

	TentacleLauncher: {
		DisplayName: 촉수 발사기
		Tooltip:
			'''
			5초마다 촉수 1개 충전, 최대 5개 저장
			마법 공격 적중 시 플랜테라 촉수 NPC를 연속 발사
			충돌 피해량 625, 적 투사체에 요격당할 수 있음
			지속 적중 기준 기본 DPS 125 (방어력, 요격 및 빗나감 미포함)
			'''
	}

	SharkLauncher: {
		DisplayName: 상어 발사기
		Tooltip:
			'''
			5초마다 상어 1마리 충전, 최대 5마리 저장
			마법 공격 적중 시 듀크 피쉬론의 상어 NPC를 연속 발사
			충돌 피해량 1,250, 적 투사체에 요격당할 수 있음
			지속 적중 기준 기본 DPS 250 (방어력, 요격 및 빗나감 미포함)
			'''
	}

	MageCharm: {
		DisplayName: Mage Charm
		Tooltip: ""
	}

	DimGate: {
		DisplayName: Dim Gate
		Tooltip: ""
	}

	DimensionGate: {
		DisplayName: Dimension Gate
		Tooltip:
			'''
			15% increases Magic damage 
			5% increases Magic critical chance
			15% increased Movement speed
			All magic projectiles inflict God Slayer Inferno for 3 seconds on hit
			Press [KEY] to enter another dimension for 5 seconds and become immune to all attacks.
			You cannot attack or dash while in another dimension.
			If you press [KEY] again when you are in another dimension, you can leave early.	
			Returning from another dimension fires 8 God Slayer Darts in all directions, each dealing 750 damage
			This effect has a 25 second cooldown and uses 500 mana.
			'''
	}

	FlameEcho: {
		Tooltip: Create a holy beam that chains between enemies.
		DisplayName: Flame Echo
	}

	BloodMage: {
		DisplayName: Porphyria
		Tooltip:
			'''
			Increases maximum life by 25%.
			Increases magic critical damage by up to 20% based on missing health
			Increases magic critical chance by up to 10% based on missing health.
			All healing is replaced with a unique energy steal effect, triggered exclusively by magic projectile hits.
			Its efficiency scales with life regeneration and missing life, and ignores the Moon Bite debuff.
			'''
	}

	BrimstoneBombTerror: {
		DisplayName: Brimstone Bomb Terror
		Tooltip: "\n\n"
	}

	GlassCannon: {
		DisplayName: Glass Cannon
		Tooltip:
			'''
			Total maximum life is reduced by 25%
			defense is reduced by 25%
			Healing potion effectiveness is reduced by 25%
			Life regeneration effectiveness is reduced by 25%
			Movement speed related stats +25%
			magic attacks ignore 25 defense
			increased magic critical chance by 12.5%
			All magic attacks have a 25% chance to trigger an additional hit.
			'''
	}

	ArcaneAugmenter: {
		Tooltip: ""
		DisplayName: Arcane Augmenter
	}

	AncientEmblem: {
		DisplayName: Ancient Emblem
		Tooltip:
			'''
			Remnants of ancient magic. 
			Materials for arcane accessory.
			'''
	}

	MonsterController: {
		DisplayName: Monster Controller
		Tooltip: ""
	}

	SpeedFreak: {
		DisplayName: Speed Freak
		Tooltip: ""
	}

	LeafShield: {
		Tooltip: ""
		DisplayName: The First Dryad's Blessing
	}

	OmegaManaPotion: {
		DisplayName: Omega Mana Potion
		Tooltip: ""
	}

	BlazingRevenant: {
		Tooltip:
			'''
			Launches wrathful Auric fireballs that relentlessly pursue enemies.
			Attack speed increases explosively in proportion to lost life.
			'''
		DisplayName: Blazing Revenant
	}

	DivineRetribution: {
		DisplayName: Divine Retribution
		Tooltip: ""
	}

	BloodGodHeart: {
		DisplayName: Blood God Heart
		Tooltip:
			'''
			+10% magic damage
			+25% maximum life
			When taking fatal damage, releases 16 Empowered Bloodflare Souls and survives with 10 life
			Cooldown is 60 seconds, and during the cooldown, life regeneration +2
			'''
	}

	AsteroidStaff: {
		DisplayName: Asteroid Staff
		Tooltip: ""
	}

	Pyromancer: {
		DisplayName: Pyromancer
		Tooltip:
			'''
			Magic projectiles brand enemies with a Flame Sigil on hit (up to 1000 stacks).
			The strength of the Flame Sigil scales with your Magic damage and Magic critical strike chance, 
			and ignores debuff immunity.
			When the Flame Sigil reaches maximum stacks,
			multiple types of burning debuffs are inflicted on the target.
			+25% Flame Sigil damage per Calamity Heat-type debuff on a branded enemy.
			Current maximum Sigil damage: [fire]
			Current Flame Sigil damage bonus: +[damage]%
			'''
	}

	ArcaneHook123: {
		DisplayName: Arcane Hook123
		Tooltip: ""
	}

	ArcaneHook: {
		DisplayName: Arcane Hook
		Tooltip: ""
	}

	Lazhar: {
		DisplayName: Lazhar
		Tooltip: ""
	}

	RuneBolt: {
		Tooltip: ""
		DisplayName: Rune Bolt
	}

	UltraCosmicDivide: {
		Tooltip: ""
		DisplayName: Ultra Cosmic Divide
	}

	HarmonyCycle: {
		Tooltip: ""
		DisplayName: Harmony Cycle
	}

	WorldBurner: {
		Tooltip: ""
		DisplayName: World Burner
	}

	RabbitLauncher: {
		Tooltip: ""
		DisplayName: Rabbit Launcher
	}

	Aureola: {
		Tooltip:
			'''
			20% increased magic damage
			10% increased magic critical strike chance
			Increases maximum mana by 150
			Reduces mana usage by 10%
			Increases mana star pickup range
			Automatically uses mana potions when needed
			Magic projectile attacks restore mana equal to 10% of damage dealt over time
			This effect's cooldown is reduced by your maximum mana.
			'''
		DisplayName: Aureola
	}

	LumenAegis: {
		Tooltip:
			'''
			When taking damage equal to or greater than 5% of your maximum health, surround yourself with an Overcharged Quantum Shield that absorbs incoming damage.
			The shield has a capacity equal to 100% of your maximum mana plus 120, grants 10% damage reduction, and dissipates after 3 seconds.
			Its cooldown ranges from 15 to 75 seconds, depending on the amount of damage absorbed by the shield.
			The shield becomes available 15 seconds after equipping the accessory.
			While the shield is on cooldown, natural health regeneration is increased by 75% and occurs 100% faster. Additionally, gain +1 to +8 health regeneration based on your missing health.
			'''
		DisplayName: Lumen Aegis
	}
}

